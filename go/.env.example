CAD_SERVER_ADDR=:8080
CAD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

CAD_DB_HOST=127.0.0.1
CAD_DB_PORT=5432
CAD_DB_NAME=cadguanliq
CAD_DB_USER=cadguanliq_app
CAD_DB_PASSWORD=replace-with-local-development-password
CAD_DB_SSL_MODE=disable
CAD_DB_MAX_CONNS=10
CAD_DB_MIN_CONNS=2
CAD_DB_HEALTH_TIMEOUT_MS=1500

UPDATE_VERSION=0.1.0
UPDATE_NOTES=暂无更新说明
UPDATE_PUBLISHED_AT=
UPDATE_DOWNLOAD_URL=
UPDATE_MANDATORY=false

# 本地附件根目录。文件会保存到：CAD_STORAGE_ROOT/<图号>/<原始文件名>
CAD_STORAGE_ROOT=./storage/attachments
CAD_MAX_UPLOAD_MB=100
