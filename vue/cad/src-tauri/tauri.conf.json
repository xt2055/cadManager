{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "图枢",
  "version": "2.0.0",
  "identifier": "com.tushu.cadpdm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bun dev --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "图枢 · CAD 图纸管理系统",
        "width": 440,
        "height": 600,
        "minWidth": 300,
        "minHeight": 440,
        "maximized": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cadguanliq"]
      }
    }
  }
}
